# =============================================================================
# AI Revenue Recovery Agent — Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=revenue_recovery

# -----------------------------------------------------------------------------
# Razorpay (Test Mode ONLY — never use production keys here)
# Get from: https://dashboard.razorpay.com/app/keys
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------------------------
# LiveKit
# Get from: https://cloud.livekit.io/ or self-hosted
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Google Gemini LLM
# Get from: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# Deepgram STT
# Get from: https://console.deepgram.com/
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# ElevenLabs TTS
# Get from: https://elevenlabs.io/
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # Default: Rachel (replace with Indian accent voice)

# -----------------------------------------------------------------------------
# Recovery Policy Configuration (adjustable thresholds)
# -----------------------------------------------------------------------------
MAX_CALL_ATTEMPTS=2
MAX_PAYMENT_LINKS=2
MAX_REMINDERS=2
MAX_RECOVERY_DAYS=7
AUTO_RECOVERY_LIMIT=5000       # INR: below this → auto recovery allowed
HIGH_VALUE_THRESHOLD=25000     # INR: above this → human escalation required

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# SMTP Email (for payment link notifications)
# For Gmail: enable 2FA → generate an App Password at
#   https://myaccount.google.com/apppasswords
# For Outlook/Office365: use smtp.office365.com, port 587
# For other providers: set SMTP_HOST and SMTP_PORT accordingly
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password   # 16-char App Password, NOT your login password
